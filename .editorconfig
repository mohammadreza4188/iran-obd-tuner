root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Persian documentation: keep trailing whitespace off, but allow long paragraphs
trim_trailing_whitespace = true
max_line_length = off

[*.{json,toml,yml,yaml}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
